# ==============================================================================
# TradingWave — Environment Configuration Template
# Target Market: India (NSE/BSE)
# ==============================================================================

# Core Application Settings
APP_ENV=development
APP_NAME=TradingWave
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
LOG_LEVEL=INFO

# Security & Sessions
# Generate with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_32_byte_hex_string_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL)
POSTGRES_USER=tradingwave
POSTGRES_PASSWORD=tradingwave_secret
POSTGRES_DB=tradingwave_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tradingwave:tradingwave_secret@localhost:5432/tradingwave_dev
ASYNC_DATABASE_URL=postgresql+asyncpg://tradingwave:tradingwave_secret@localhost:5432/tradingwave_dev

# Cache & Task Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Storage for Market Data (Parquet) & Backtest Results
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=ap-south-1

# AI Strategy Studio Gateway (Server-side LLM provider)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30

# Regulatory & Operational Hard Gates (SEBI / Indian Exchange Compliance)
# LIVE_TRADING_ENABLED MUST BE FALSE BY DEFAULT.
LIVE_TRADING_ENABLED=false
SEBI_COMPLIANCE_GATE_ACTIVE=true
ALLOW_UNLICENSED_LIVE_EXECUTION=false
EMERGENCY_KILL_SWITCH_ACTIVE=false
